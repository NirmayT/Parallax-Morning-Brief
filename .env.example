# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional reply-to identity
SENDER_EMAIL=your_reply_to_email_here

# Supabase subscriber database (server-side secret; never expose in browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key_here

# Resend exact-HTML delivery
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Parallax Morning Brief <brief@updates.yourdomain.com>
RESEND_REPLY_TO=your_reply_to_email_here

# Public website routes used in unsubscribe links
PUBLIC_SITE_URL=https://yourdomain.com

# Safety limit for one production broadcast
BROADCAST_MAX_RECIPIENTS=90

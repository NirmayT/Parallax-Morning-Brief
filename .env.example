# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail / source ingestion
SENDER_EMAIL=your_reply_to_email_here

# Supabase subscriber database (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key_here

# Resend exact-HTML delivery
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Parallax Morning Brief <newsletter@parallaxresearchgroup.ca>
RESEND_REPLY_TO=your_reply_to_email_here

# Public website and broadcast safety
PUBLIC_SITE_URL=https://parallaxresearchgroup.ca
BROADCAST_MAX_RECIPIENTS=90

# Newsletter identification / compliance
PUBLISHER_NAME=Parallax Research Group
COMPLIANCE_CONTACT_EMAIL=newsletter@parallaxresearchgroup.ca
SUBSCRIPTION_DISCLOSURE=You are receiving this email because you subscribed to the Parallax Morning Brief at parallaxresearchgroup.ca.
